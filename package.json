{
  "name": "@stringzhao/gemini-mcp",
  "version": "1.0.2",
  "description": "MCP server that wraps Google Gemini CLI, enabling other models to call Gemini",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gemini-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
