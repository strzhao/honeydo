{
  "name": "@stringzhao/minimax",
  "version": "1.0.0",
  "description": "minimax — CLI for the MiniMax API (text-to-audio, voice clone, voice list)",
  "main": "dist/cli.js",
  "bin": {
    "minimax": "dist/cli.js"
  },
  "type": "module",
